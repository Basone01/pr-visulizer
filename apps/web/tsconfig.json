{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // Browser bundle: Vite/esbuild bundles, so use bundler resolution + DOM libs
    // and react-jsx. The strict/erasable/verbatim flags come from the base.
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client", "vitest/globals", "@testing-library/jest-dom"],
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src", "vite.config.ts", "vitest.config.ts"]
}
