{
  "name": "@pr-visulizer/engine",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./browser": {
      "types": "./src/browser.ts",
      "default": "./src/browser.ts"
    },
    "./parser": {
      "types": "./src/services/analysis/treeSitter.ts",
      "default": "./src/services/analysis/treeSitter.ts"
    },
    "./node": {
      "types": "./src/node.ts",
      "default": "./src/node.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@octokit/rest": "^21.1.0",
    "@pr-visulizer/shared": "workspace:*",
    "lru-cache": "^11.1.0",
    "tree-sitter-wasms": "^0.1.11",
    "web-tree-sitter": "^0.25.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
